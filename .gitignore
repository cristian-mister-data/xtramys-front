# Keep store-policy source files versioned; generated build artifacts stay ignored below.
!/android/
/android/*
!/android/app/
/android/app/*
!/android/app/build.gradle
!/android/app/src/
/android/app/src/*
!/android/app/src/main/
/android/app/src/main/*
!/android/app/src/main/AndroidManifest.xml
!/ios/
/ios/*
!/ios/App/
/ios/App/*
!/ios/App/App/
/ios/App/App/*
!/ios/App/App/Info.plist
!/ios/App/App/PrivacyInfo.xcprivacy
!/ios/App/App.xcodeproj/
/ios/App/App.xcodeproj/*
!/ios/App/App.xcodeproj/project.pbxproj

# Reserved Windows device name accidentally created by tooling; cannot be
# safely deleted from the working tree, must not be indexed.
/nul
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Android / iOS generated builds and binaries
*.apk
*.aab
*.aar
*.ipa

# Capacitor / Native build artifacts & local configurations
/android/.gradle
/android/build
/android/app/build
/android/local.properties
/android/app/src/main/assets/public
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/xml/config.xml
/android/capacitor-cordova-android-plugins

# iOS specific build folders
/ios/App/build
/ios/App/Pods
/ios/App/Podfile.lock

