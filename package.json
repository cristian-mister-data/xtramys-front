{
  "name": "xtramys-front-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Xtramys web application",
  "scripts": {
    "dev": "vite .",
    "build": "vite build",
    "check:lineup-positions": "node scripts/check-lineup-positions.mjs",
    "check:set-piece-kits": "node scripts/check-set-piece-kits.mjs",
    "check:mobile-subscriptions": "node scripts/check-mobile-subscriptions.mjs",
    "check:subscription-flow": "node scripts/check-subscription-flow.mjs",
    "check:ios-native-flows": "node scripts/check-ios-native-flows.mjs",
    "check:app-version": "node scripts/check-app-version.mjs",
    "check:tactical-board-performance": "node scripts/check-tactical-board-performance.mjs",
    "preview": "vite preview --port 4173",
    "mobile": "npm run build && npx cap sync",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\""
  },
  "dependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@expo/vector-icons": "14.0.4",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@paypal/react-paypal-js": "^9.2.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-oauth/google": "^0.13.5",
    "@react-pdf/renderer": "^4.5.1",
    "@reduxjs/toolkit": "^2.2.7",
    "axios": "^1.7.7",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "jspdf": "^4.2.1",
    "jwt-decode": "^4.0.0",
    "konva": "^9.3.16",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-color": "^2.19.3",
    "react-datepicker": "^7.5.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-icons": "^5.3.0",
    "react-konva": "^18.2.10",
    "react-native-gesture-handler": "2.16.2",
    "react-native-safe-area-context": "4.10.9",
    "react-native-svg": "15.4.0",
    "react-native-web": "0.19.12",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@babel/plugin-transform-block-scoping": "^7.28.6",
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.11.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.3.3",
    "vite": "^5.4.7"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.74.5"
  }
}
