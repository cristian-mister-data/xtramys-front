{
  "appId": "com.xtramys.app",
  "appName": "Xtramys",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "hostname": "app.xtramys.com",
    "androidScheme": "https"
  },
  "backgroundColor": "#000000",
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DEFAULT",
      "backgroundColor": "#000000"
    },
    "SystemBars": {
      "insetsHandling": "css"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "LocalNotifications": {
      "presentationOptions": ["badge", "sound", "banner", "list"]
    }
  }
}
