# Backend API
# VITE_BACKEND_URL se usa para BACKEND_URL (apiBase, enlaces directos).
# API_URL en desarrollo usa el proxy de Vite (vite.config.js) → no CORS.
# En producción (vite build), VITE_BACKEND_URL debe apuntar al backend real.
# Ejemplo: VITE_BACKEND_URL=https://api.xtramys.com
VITE_BACKEND_URL=http://localhost:3000

VITE_R2_PUBLIC_URL=https://cdn.xtramys.com

# Auth modo: 'cookie' (httpOnly + credentials) o 'bearer' (legacy / móvil)
VITE_AUTH_MODE=cookie

# Google OAuth (requerido para login con Google)
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# PayPal (requerido para pagos con PayPal)
VITE_PAYPAL_CLIENT_ID=

# Stripe (opcional, solo si se usa Stripe.js en cliente; con Checkout Sessions no es necesario)
VITE_STRIPE_PK=